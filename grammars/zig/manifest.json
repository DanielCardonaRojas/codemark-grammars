{
  "extensions": [
    "zig",
    "zon"
  ],
  "curation": {
    "drop_containers": [
      [
        "variable_declaration",
        "type"
      ],
      [
        "struct_declaration",
        "name"
      ]
    ],
    "why": "a Zig struct is an anonymous value bound by the enclosing variable_declaration, so it has no name of its own; variable_declaration's 'type' field is a type, not a name \u2014 a breadcrumb reading 'f64' helps nobody."
  },
  "name": "zig",
  "profile": {
    "containers": [
      [
        "function_declaration",
        "name"
      ]
    ],
    "landmark_kinds": [
      "function_declaration",
      "struct_declaration",
      "variable_declaration"
    ],
    "node_labels": {
      "for_statement": "for loop",
      "function_declaration": "function",
      "if_statement": "if statement",
      "return_expression": "return",
      "struct_declaration": "class",
      "variable_declaration": "variable"
    }
  },
  "version": "1.0.0"
}
