{
  "extensions": [
    "zig",
    "zon"
  ],
  "curation": {
    "drop_containers": [
      [
        "variable_declaration",
        "type"
      ],
      [
        "struct_declaration",
        "name"
      ]
    ],
    "why": "a Zig struct is an anonymous value bound by the enclosing variable_declaration, so it has no name of its own and cannot be a container; variable_declaration's 'type' field is a type, not a name \u2014 a breadcrumb reading 'f64' helps nobody. Both stay as landmarks (they are real query anchors) but neither can name a breadcrumb, which is why every trail here names a function."
  },
  "name": "zig",
  "profile": {
    "containers": [
      [
        "function_declaration",
        "name"
      ]
    ],
    "landmark_kinds": [
      "enum_declaration",
      "function_declaration",
      "function_signature",
      "struct_declaration",
      "variable_declaration"
    ],
    "node_labels": {
      "assignment_expression": "assignment",
      "call_expression": "call",
      "enum_declaration": "enum",
      "for_statement": "for loop",
      "function_declaration": "function",
      "function_signature": "function",
      "if_statement": "if statement",
      "return_expression": "return",
      "struct_declaration": "class",
      "switch_expression": "match",
      "variable_declaration": "variable",
      "while_statement": "while loop"
    }
  },
  "version": "1.1.0"
}
