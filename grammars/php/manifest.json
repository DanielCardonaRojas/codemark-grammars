{
  "extensions": [
    "php",
    "phtml"
  ],
  "curation": {
    "drop_landmarks": [
      "declaration_list",
      "property_declaration"
    ],
    "add_containers": [
      [
        "namespace_definition",
        "name"
      ],
      [
        "method_declaration",
        "name"
      ],
      [
        "function_definition",
        "name"
      ]
    ],
    "why": "declaration_list is the { } body. The semicolon form of namespace never encloses anything in the AST, so it must be added rather than observed; methods and functions likewise nest in real code."
  },
  "name": "php",
  "profile": {
    "containers": [
      [
        "class_declaration",
        "name"
      ],
      [
        "interface_declaration",
        "name"
      ],
      [
        "namespace_definition",
        "name"
      ],
      [
        "method_declaration",
        "name"
      ],
      [
        "function_definition",
        "name"
      ]
    ],
    "landmark_kinds": [
      "class_declaration",
      "function_definition",
      "interface_declaration",
      "method_declaration",
      "namespace_definition"
    ],
    "node_labels": {
      "assignment_expression": "assignment",
      "augmented_assignment_expression": "assignment",
      "class_declaration": "class",
      "function_call_expression": "call",
      "function_definition": "function",
      "if_statement": "if statement",
      "interface_declaration": "interface",
      "method_declaration": "method",
      "namespace_definition": "namespace",
      "return_statement": "return"
    }
  },
  "version": "1.0.0"
}
