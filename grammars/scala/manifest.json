{
  "extensions": [
    "scala",
    "sc"
  ],
  "curation": {
    "drop_landmarks": [
      "class_parameter",
      "class_parameters",
      "val_definition",
      "var_definition"
    ],
    "add_containers": [
      [
        "function_definition",
        "name"
      ]
    ],
    "why": "the class_parameter* kinds are constructor-parameter wrappers; var_definition and val_definition name a 'type', not a name. The two dropped labels are expression kinds the sample happens to contain but which add nothing to a summary.",
    "drop_labels": [
      "assignment_expression",
      "call_expression"
    ]
  },
  "name": "scala",
  "profile": {
    "containers": [
      [
        "class_definition",
        "name"
      ],
      [
        "object_definition",
        "name"
      ],
      [
        "trait_definition",
        "name"
      ],
      [
        "function_definition",
        "name"
      ]
    ],
    "landmark_kinds": [
      "class_definition",
      "function_declaration",
      "function_definition",
      "object_definition",
      "trait_definition"
    ],
    "node_labels": {
      "class_definition": "class",
      "for_expression": "for loop",
      "function_declaration": "function",
      "function_definition": "function",
      "if_expression": "if statement",
      "trait_definition": "interface"
    }
  },
  "version": "1.0.0"
}
