{
  "extensions": [
    "rb",
    "rake",
    "gemspec"
  ],
  "curation": {
    "add_containers": [
      [
        "method",
        "name"
      ],
      [
        "singleton_method",
        "name"
      ]
    ],
    "why": "methods nest statements in real code; this sample's hold only control flow, so the generator correctly declines to propose them."
  },
  "name": "ruby",
  "profile": {
    "containers": [
      [
        "class",
        "name"
      ],
      [
        "module",
        "name"
      ],
      [
        "method",
        "name"
      ],
      [
        "singleton_method",
        "name"
      ]
    ],
    "landmark_kinds": [
      "class",
      "method",
      "module",
      "singleton_method"
    ],
    "node_labels": {
      "assignment": "assignment",
      "call": "call",
      "class": "class",
      "if": "if statement",
      "method": "method",
      "module": "module",
      "operator_assignment": "assignment",
      "singleton_method": "method"
    }
  },
  "version": "1.0.0"
}
