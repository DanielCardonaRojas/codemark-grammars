{
  "extensions": [
    "rb",
    "rake",
    "gemspec"
  ],
  "curation": {
    "drop_landmarks": [
      "method_parameters",
      "singleton_class"
    ],
    "add_containers": [
      "method"
    ],
    "why": "method_parameters is a parameter-list wrapper and singleton_class is the `class << self` block, neither of which is a declaration. singleton_method is a container in real code but this sample's hold only a constructor call."
  },
  "name": "ruby",
  "profile": {
    "landmark_kinds": [
      "class",
      "method",
      "module",
      "singleton_method"
    ],
    "node_labels": {
      "assignment": "assignment",
      "call": "call",
      "class": "class",
      "if": "if statement",
      "if_modifier": "if statement",
      "method": "method",
      "module": "module",
      "operator_assignment": "assignment",
      "singleton_method": "method"
    },
    "containers": [
      "class",
      "method",
      "module"
    ]
  },
  "version": "1.1.0"
}
