{
  "extensions": [
    "ts"
  ],
  "curation": {
    "drop_landmarks": [
      "class_body",
      "property_signature",
      "public_field_definition"
    ],
    "add_containers": [
      [
        "internal_module",
        "name"
      ],
      [
        "method_definition",
        "name"
      ],
      [
        "function_declaration",
        "name"
      ]
    ],
    "why": "class_body is a wrapper; signatures and field definitions declare nothing nestable. internal_module (namespace) is added rather than observed: a bookmark inside a namespace cannot be created at all (codemark#246), so the sample avoids them \u2014 but it remains the right container kind once that is fixed.",
    "add_landmarks": [
      "internal_module"
    ],
    "add_labels": {
      "internal_module": "module"
    }
  },
  "name": "typescript",
  "profile": {
    "containers": [
      [
        "class_declaration",
        "name"
      ],
      [
        "interface_declaration",
        "name"
      ],
      [
        "internal_module",
        "name"
      ],
      [
        "type_alias_declaration",
        "name"
      ],
      [
        "method_definition",
        "name"
      ],
      [
        "function_declaration",
        "name"
      ]
    ],
    "landmark_kinds": [
      "class_declaration",
      "enum_declaration",
      "function_declaration",
      "interface_declaration",
      "internal_module",
      "method_definition",
      "method_signature",
      "type_alias_declaration"
    ],
    "node_labels": {
      "augmented_assignment_expression": "assignment",
      "call_expression": "call",
      "class_declaration": "class",
      "enum_assignment": "assignment",
      "enum_declaration": "enum",
      "for_in_statement": "for loop",
      "function_declaration": "function",
      "if_statement": "if statement",
      "interface_declaration": "interface",
      "internal_module": "module",
      "method_definition": "method",
      "method_signature": "method",
      "return_statement": "return",
      "type_alias_declaration": "type"
    }
  },
  "version": "1.0.0"
}
