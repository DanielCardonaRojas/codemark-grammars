{
  "extensions": [
    "ts"
  ],
  "curation": {
    "drop_landmarks": [
      "class_body",
      "property_signature",
      "public_field_definition"
    ],
    "add_containers": [
      "module",
      "method",
      "function"
    ],
    "why": "class_body is a wrapper; signatures and field definitions declare nothing nestable. internal_module (namespace) is added rather than observed: a bookmark inside a namespace cannot be created at all (codemark#246), so the sample avoids them \u2014 but it remains the right container kind once that is fixed. type_alias_declaration is labelled 'type' and is a one-liner here, so it is no longer a container. That matches the rule: a container is a landmark with a body, because having a body is what makes a kind worth pinning while scrolling.",
    "add_landmarks": [
      "internal_module"
    ],
    "add_labels": {
      "internal_module": "module"
    }
  },
  "name": "typescript",
  "profile": {
    "landmark_kinds": [
      "class_declaration",
      "enum_declaration",
      "function_declaration",
      "interface_declaration",
      "internal_module",
      "method_definition",
      "method_signature",
      "type_alias_declaration"
    ],
    "node_labels": {
      "augmented_assignment_expression": "assignment",
      "call_expression": "call",
      "class_declaration": "class",
      "enum_assignment": "assignment",
      "enum_declaration": "enum",
      "for_in_statement": "for loop",
      "function_declaration": "function",
      "if_statement": "if statement",
      "interface_declaration": "interface",
      "method_definition": "method",
      "method_signature": "method",
      "return_statement": "return",
      "type_alias_declaration": "type",
      "internal_module": "module"
    },
    "containers": [
      "class",
      "enum",
      "function",
      "interface",
      "method",
      "module"
    ]
  },
  "version": "1.0.0"
}
