{
  "extensions": [
    "cs",
    "csx"
  ],
  "curation": {
    "drop_landmarks": [
      "declaration_list",
      "foreach_statement",
      "variable_declaration"
    ],
    "add_containers": [
      [
        "constructor_declaration",
        "name"
      ]
    ],
    "why": "declaration_list is the { } body wrapper; foreach_statement is control flow and variable_declaration matched on a 'type' field, not a name. A constructor nests statements in real code even though this sample's doesn't."
  },
  "name": "c_sharp",
  "profile": {
    "containers": [
      [
        "class_declaration",
        "name"
      ],
      [
        "interface_declaration",
        "name"
      ],
      [
        "method_declaration",
        "name"
      ],
      [
        "namespace_declaration",
        "name"
      ],
      [
        "property_declaration",
        "name"
      ],
      [
        "constructor_declaration",
        "name"
      ]
    ],
    "landmark_kinds": [
      "accessor_declaration",
      "class_declaration",
      "constructor_declaration",
      "field_declaration",
      "interface_declaration",
      "method_declaration",
      "namespace_declaration",
      "property_declaration"
    ],
    "node_labels": {
      "assignment_expression": "assignment",
      "class_declaration": "class",
      "constructor_declaration": "constructor",
      "field_declaration": "variable",
      "if_statement": "if statement",
      "interface_declaration": "interface",
      "method_declaration": "method",
      "namespace_declaration": "namespace",
      "property_declaration": "variable",
      "return_statement": "return"
    }
  },
  "version": "1.0.0"
}
